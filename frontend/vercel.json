{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/studio.css",
      "dest": "/studio.css"
    },
    {
      "src": "/studio.js",
      "dest": "/studio.js"
    },
    {
      "src": "/studio",
      "dest": "/index.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
