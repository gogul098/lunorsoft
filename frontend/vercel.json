{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/config",
      "destination": "/api/config.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "${BACKEND_URL}/api/$1",
      "env": ["BACKEND_URL"]
    },
    {
      "source": "/studio",
      "destination": "/index.html"
    }
  ]
}
